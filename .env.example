# API
API_PORT=3101
MONGODB_URI=mongodb://localhost:27017/ranhduong
# S13: chỉ đặt sau khi tạo Atlas Search index theo docs/runbooks/place-search.md; local để trống
PLACE_SEARCH_INDEX=
REDIS_URL=redis://localhost:6379
# S24: WeatherAPI Free (weatherapi.com/signup.aspx); server-only. Trống thì ẩn ô thời tiết.
WEATHERAPI_KEY=
# S18: chỉ tin X-Forwarded-For khi socket peer thuộc IP/CIDR proxy đã cấu hình; local để trống
TRUSTED_PROXY_CIDRS=
# Production: https://ranhduong.vn,https://admin.ranhduong.vn
WEB_ORIGINS=http://localhost:3100,http://localhost:5174

# Đăng nhập admin (S04), xem docs/runbooks/admin-login.md. API không chạy nếu thiếu GOOGLE_CLIENT_ID/SECRET.
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:3101
ADMIN_URL=http://localhost:5174
# S30: URL web khách in trên vé lịch trình (QR, đường dẫn rút gọn). Production https://ranhduong.vn, staging https://staging.ranhduong.vn
SITE_URL=http://localhost:3100
# Production: .ranhduong.vn; staging: .staging.ranhduong.vn; local để trống
SESSION_COOKIE_DOMAIN=
# Staging đặt khác production (ví dụ sid_staging)
SESSION_COOKIE_NAME=sid

# Lưu ảnh (S06): Cloudflare R2, local dùng MinIO trong docker-compose
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minio
R2_SECRET_ACCESS_KEY=minio12345
R2_BUCKET=ranhduong-media
# Riêng tư: KHÔNG bật public access hoặc gắn media domain cho bucket này
R2_UPLOAD_BUCKET=ranhduong-uploads

# Import OSM (S08); có thể đổi sang endpoint Overpass khác khi máy chủ bận
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Web (Nuxt đọc biến NUXT_PUBLIC_*)
NUXT_PUBLIC_API_BASE=http://localhost:3101/v1
# SSR gọi API qua mạng nội bộ (production: http://api:3001/v1); để trống ở local
NUXT_API_INTERNAL_BASE=
NUXT_PUBLIC_MEDIA_BASE=http://localhost:9000/ranhduong-media
# S22: style sổ tay trong repo; có thể đổi sang URL style khác khi triển khai
NUXT_PUBLIC_MAP_STYLE_URL=/maps/notebook/style.json
# S17: URL gốc dùng cho canonical, OG, JSON-LD và sitemap
NUXT_PUBLIC_SITE_URL=https://ranhduong.vn
# Staging/local preview đặt false; production đặt true
NUXT_PUBLIC_INDEXABLE=true
# Chỉ nội dung token, không dán toàn bộ thẻ meta; domain property có thể xác minh bằng DNS
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# S18: đặt false trên staging; telemetry địa điểm độc lập với consent analytics
NUXT_PUBLIC_TRACKING_ENABLED=true
# Umami chỉ tải sau khi khách cho phép. URL script và Website ID của instance thật
NUXT_PUBLIC_UMAMI_SCRIPT_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
# S20: email công khai, có người theo dõi để nhận yêu cầu về dữ liệu và bản quyền; đặt trước khi ra mắt
NUXT_PUBLIC_LEGAL_CONTACT_EMAIL=
