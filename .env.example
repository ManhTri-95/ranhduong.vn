# API
API_PORT=3101
MONGODB_URI=mongodb://localhost:27017/ranhduong
# S13: chỉ đặt sau khi tạo Atlas Search index theo docs/runbooks/place-search.md; local để trống
PLACE_SEARCH_INDEX=
REDIS_URL=redis://localhost:6379
# Production: https://ranhduong.vn,https://admin.ranhduong.vn
WEB_ORIGINS=http://localhost:3100,http://localhost:5174

# Đăng nhập admin (S04), xem docs/runbooks/admin-login.md. API không chạy nếu thiếu GOOGLE_CLIENT_ID/SECRET.
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:3101
ADMIN_URL=http://localhost:5174
# Production: .ranhduong.vn; staging: .staging.ranhduong.vn; local để trống
SESSION_COOKIE_DOMAIN=
# Staging đặt khác production (ví dụ sid_staging)
SESSION_COOKIE_NAME=sid

# Lưu ảnh (S06): Cloudflare R2, local dùng MinIO trong docker-compose
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minio
R2_SECRET_ACCESS_KEY=minio12345
R2_BUCKET=ranhduong-media
# Riêng tư: KHÔNG bật public access hoặc gắn media domain cho bucket này
R2_UPLOAD_BUCKET=ranhduong-uploads

# Import OSM (S08); có thể đổi sang endpoint Overpass khác khi máy chủ bận
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Web (Nuxt đọc biến NUXT_PUBLIC_*)
NUXT_PUBLIC_API_BASE=http://localhost:3101/v1
# SSR gọi API qua mạng nội bộ (production: http://api:3001/v1); để trống ở local
NUXT_API_INTERNAL_BASE=
NUXT_PUBLIC_MEDIA_BASE=http://localhost:9000/ranhduong-media
NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
