{
  "name": "@ranhduong/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:prelaunch": "node prelaunch/build.mjs",
    "preview:prelaunch": "wrangler dev --config prelaunch/wrangler.jsonc",
    "deploy:prelaunch": "node prelaunch/build.mjs && wrangler deploy --config prelaunch/wrangler.jsonc",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@ranhduong/contracts": "workspace:*",
    "@ranhduong/geo": "workspace:*",
    "@ranhduong/ui": "workspace:*",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@ranhduong/config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "4.148.0"
  }
}
