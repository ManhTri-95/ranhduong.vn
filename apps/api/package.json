{
  "name": "@ranhduong/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file .env",
    "start": "node dist/main.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker --env-file .env",
    "media:setup:local": "node --env-file-if-exists=.env scripts/setup-media-local.mjs",
    "seed": "node --env-file-if-exists=.env dist/seed/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@ranhduong/contracts": "workspace:*",
    "@ranhduong/geo": "workspace:*",
    "bullmq": "^6.3.11",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "mongoose": "^9.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@oxc-project/runtime": "^0.153.0",
    "@ranhduong/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
